{
  "schemaVersion": 1,
  "networks": {
    "testnet": {
      "cliNetwork": "testnet",
      "rpcUrl": "https://soroban-testnet.stellar.org",
      "horizonUrl": "https://horizon-testnet.stellar.org",
      "networkPassphrase": "Test SDF Network ; September 2015"
    },
    "mainnet": {
      "cliNetwork": "mainnet",
      "rpcUrl": "https://soroban.stellar.org",
      "horizonUrl": "https://horizon.stellar.org",
      "networkPassphrase": "Public Global Stellar Network ; September 2015"
    }
  },
  "contracts": [
    {
      "name": "strategy-registry",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}"
      }
    },
    {
      "name": "reward-distributor",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}",
        "treasury": "${TREASURY_ADDRESS}",
        "swap_router": "${SWAP_ROUTER_ADDRESS}"
      }
    },
    {
      "name": "yield-vault",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}",
        "name": "YieldVault",
        "token_a": "${TOKEN_A_ADDRESS}",
        "token_b": "${TOKEN_B_ADDRESS}",
        "pool_id": "${POOL_ID}",
        "strategy_id": "${STRATEGY_ID}",
        "fee_rate": "100",
        "harvest_fee": "50",
        "withdrawal_fee": "100",
        "treasury": "${TREASURY_ADDRESS}"
      }
    },
    {
      "name": "rebalance-engine",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}"
      }
    },
    {
      "name": "il-insurance",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}",
        "reserve_token": "${RESERVE_TOKEN_ADDRESS}"
      }
    },
    {
      "name": "actuary",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}"
      }
    },
    {
      "name": "oracle-registry",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}"
      }
    },
    {
      "name": "risk-engine",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}"
      }
    },
    {
      "name": "engine",
      "initialize": {
        "admin": "${ADMIN_ADDRESS}",
        "strategy_registry": "${STRATEGY_REGISTRY_ADDRESS}",
        "reward_distributor": "${REWARD_DISTRIBUTOR_ADDRESS}"
      }
    }
  ]
}
