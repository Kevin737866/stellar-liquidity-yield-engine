{
  "schemaVersion": 1,
  "network": "testnet",
  "cliNetwork": "testnet",
  "rpcUrl": "https://soroban-testnet.stellar.org",
  "horizonUrl": "https://horizon-testnet.stellar.org",
  "networkPassphrase": "Test SDF Network ; September 2015",
  "contracts": [
    {
      "name": "strategy-registry",
      "build": {
        "feature": "strategy-registry",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}"
        }
      }
    },
    {
      "name": "reward-distributor",
      "build": {
        "feature": "reward-distributor",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}",
          "treasury": "${TREASURY_ADDRESS}",
          "swap_router": "${SWAP_ROUTER_ADDRESS}"
        }
      }
    },
    {
      "name": "yield-vault",
      "build": {
        "feature": "yield-vault",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}",
          "name": "YieldVault",
          "token_a": "${TOKEN_A_ADDRESS}",
          "token_b": "${TOKEN_B_ADDRESS}",
          "pool_id": "${POOL_ID}",
          "strategy_id": "${STRATEGY_ID}",
          "fee_rate": "100",
          "harvest_fee": "50",
          "withdrawal_fee": "100",
          "treasury": "${TREASURY_ADDRESS}"
        }
      }
    },
    {
      "name": "rebalance-engine",
      "build": {
        "feature": "rebalance-engine",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}"
        }
      }
    },
    {
      "name": "il-insurance",
      "build": {
        "feature": "il-insurance",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}",
          "reserve_token": "${RESERVE_TOKEN_ADDRESS}"
        }
      }
    },
    {
      "name": "actuary",
      "build": {
        "feature": "actuary",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}"
        }
      }
    },
    {
      "name": "oracle-registry",
      "build": {
        "feature": "oracle-registry",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}"
        }
      }
    },
    {
      "name": "risk-engine",
      "build": {
        "feature": "risk-engine",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}"
        }
      }
    },
    {
      "name": "engine",
      "build": {
        "feature": "engine",
        "wasmPath": "target/wasm32-unknown-unknown/release/stellar_liquidity_yield_engine.wasm"
      },
      "initialize": {
        "method": "initialize",
        "arguments": {
          "admin": "${ADMIN_ADDRESS}",
          "strategy_registry": "${STRATEGY_REGISTRY_ADDRESS}",
          "reward_distributor": "${REWARD_DISTRIBUTOR_ADDRESS}"
        }
      }
    }
  ]
}
