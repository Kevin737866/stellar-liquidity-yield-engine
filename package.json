{
  "name": "stellar-liquidity-yield-engine-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Stellar liquidity and yield optimization engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.sdk.json",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint \"sdk/src/**/*.ts\"",
    "clean": "rm -rf dist",
    "release:check": "node scripts/check-release.cjs",
    "release:dry-run": "npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "stellar",
    "defi",
    "yield",
    "liquidity",
    "amm",
    "soroban"
  ],
  "author": "Stellar Yield Engine Team",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
