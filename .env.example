# Copy this file to .env and fill in real values.
# .env is already git-ignored (see .gitignore) — never commit real keys.

# ===== Network configuration =====
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ===== Contract addresses =====
# Fill these in with the contract IDs printed by `soroban contract deploy`
# (see the "Contract Deployment" section in README.md).
YIELD_ENGINE_ADDRESS=
REWARD_DISTRIBUTOR_ADDRESS=
REBALANCE_ENGINE_ADDRESS=
STRATEGY_REGISTRY_ADDRESS=

# ===== Bot configuration =====
# NOTE: the example bots under examples/ (e.g. yield-harvest-bot.ts) currently
# hardcode this configuration in-file rather than reading it from the
# environment. These variables document the intended convention for anyone
# wiring the examples up to real config — update the example's BOT_CONFIG /
# BOT_KEYPAIR objects to read from process.env if you want that behavior.
BOT_PRIVATE_KEY=
HARVEST_THRESHOLD=1000
CHECK_INTERVAL=300000

# ===== Governance (NOT FUNCTIONAL) =====
# src/governance.rs is a non-compiling stub (~40 todo!() storage-key
# functions, no real token transfers). These addresses are read by
# sdk/src/governance.ts but there is no working contract to deploy them
# against yet. See GOVERNANCE_STATUS.md before using this section.
GOVERNANCE_CONTRACT=
VOTING_ESCROW_CONTRACT=
STAKING_CONTRACT=
FEE_DISTRIBUTOR_CONTRACT=
