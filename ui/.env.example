# UI environment configuration
#
# Copy to `ui/.env.local` (git-ignored) and fill in real values:
#   cp .env.example .env.local
#
# Everything here is prefixed with NEXT_PUBLIC_ because Next.js only exposes
# those to the browser bundle, and it inlines them at build time. That means:
#
#   * These values are PUBLIC. Never put a private key (BOT_PRIVATE_KEY, a
#     seed phrase, an API secret) in this file. The UI signs through the
#     Freighter browser extension, so it never needs a signing key.
#   * Lookup must be a literal `process.env.NEXT_PUBLIC_FOO`. Next.js cannot
#     inline dynamic lookups like `process.env[name]`. All reads live in
#     `src/config/network.ts`; do not read process.env anywhere else.
#
# Every variable is optional. Unset endpoints fall back to the public testnet
# URLs, and unset contract IDs stay empty (the SDK then reports the contract as
# unconfigured rather than calling a placeholder address).
#
# See `.emdfile` at the repo root for the full convention.

# ===== Network selection =====
# "testnet" (default) or "mainnet".
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ===== Endpoints =====
# Point these at a custom RPC / Horizon node if you are not using the public
# ones. Leave blank to use the public default for that network.
NEXT_PUBLIC_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_MAINNET_HORIZON_URL=https://horizon.stellar.org
NEXT_PUBLIC_MAINNET_SOROBAN_RPC_URL=https://soroban.stellar.org

# Only override these for a private/local network. The public network
# passphrases are built in.
# NEXT_PUBLIC_TESTNET_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# NEXT_PUBLIC_MAINNET_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# ===== Deployed contract IDs =====
# Fill these in with the contract IDs printed by `soroban contract deploy`
# (see the "Contract Deployment" section of the README). The variable names
# match the server-side names the SDK reads in sdk/src/index.ts.
#
# Yield engine contracts
NEXT_PUBLIC_YIELD_ENGINE_CONTRACT_ID=
NEXT_PUBLIC_REWARD_DISTRIBUTOR_CONTRACT_ID=
NEXT_PUBLIC_REBALANCE_ENGINE_CONTRACT_ID=
NEXT_PUBLIC_STRATEGY_REGISTRY_CONTRACT_ID=

# Governance contracts
# NOTE: src/governance.rs is currently a non-compiling stub. Read
# GOVERNANCE_STATUS.md before pointing these at a deployment.
NEXT_PUBLIC_GOVERNANCE_CONTRACT_ID=
NEXT_PUBLIC_VOTING_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_STAKING_CONTRACT_ID=
NEXT_PUBLIC_FEE_DISTRIBUTOR_CONTRACT_ID=
